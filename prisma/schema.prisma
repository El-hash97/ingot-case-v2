generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres (PRD 5.3). Connection URL lives in prisma.config.ts + the
  // driver adapter in src/lib/prisma.ts (Prisma 7 driver-adapter model),
  // not here.
  provider = "postgresql"
}

enum Role {
  OPERATOR
  LEADER
}

enum ShiftColor {
  RED
  WHITE
}

enum TimePeriod {
  DAY
  NIGHT
}

enum CaseStatus {
  ACTIVE
  WARNING
  NG
  SCRAPPED
}

enum MaintenanceAction {
  CREATE
  RESET
  SCRAP
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  shiftLogs       ShiftLog[]
  maintenanceLogs MaintenanceLog[]
}

model IngotCase {
  id               String     @id @default(cuid())
  caseNumber       String     @unique
  totalTonnageKg   Decimal    @default(0)
  maxTonnageKg     Decimal    @default(20000)
  warningTonnageKg Decimal    @default(16000)
  status           CaseStatus @default(ACTIVE)
  cycleCount       Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  pouringEntries  PouringEntry[]
  maintenanceLogs MaintenanceLog[]
}

model ShiftLog {
  id         String     @id @default(cuid())
  logDate    DateTime
  shiftColor ShiftColor
  timePeriod TimePeriod
  operatorId String
  operator   User       @relation(fields: [operatorId], references: [id])
  createdAt  DateTime   @default(now())

  pouringEntries PouringEntry[]
}

model PouringEntry {
  id           String    @id @default(cuid())
  shiftLogId   String
  shiftLog     ShiftLog  @relation(fields: [shiftLogId], references: [id], onDelete: Cascade)
  ingotCaseId  String
  ingotCase    IngotCase @relation(fields: [ingotCaseId], references: [id])
  weightKg     Decimal   @default(600)
  tonnageAfter Decimal
  createdAt    DateTime  @default(now())

  @@index([ingotCaseId])
  @@index([shiftLogId])
}

model MaintenanceLog {
  id            String            @id @default(cuid())
  ingotCaseId   String
  ingotCase     IngotCase         @relation(fields: [ingotCaseId], references: [id])
  leaderId      String
  leader        User              @relation(fields: [leaderId], references: [id])
  actionType    MaintenanceAction
  tonnageBefore Decimal
  notes         String
  createdAt     DateTime          @default(now())

  @@index([ingotCaseId])
}
